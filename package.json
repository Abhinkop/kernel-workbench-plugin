			{
				"view": "kernelWorkbench.series",
				"contents": "No base for the series: the branch has no upstream and the ref in [kernelWorkbench.patches.base](command:workbench.action.openSettings?%5B%22kernelWorkbench.patches.base%22%5D) does not exist in this repository.\n[Pick the Base](command:kernelWorkbench.series.pickBase)",
				"when": "kernelWorkbench.seriesNoBase"
			}
		],
		"problemMatchers": [
			{
				"name": "kernel-coccinelle",
				"owner": "coccinelle",
				"source": "coccinelle",
				"fileLocation": [
					"relative",
					"${workspaceFolder}"
				],
				"severity": "warning",
				"pattern": {
					"regexp": "^([^\\s:]+\\.[ch]):(\\d+):(\\d+)-(\\d+): (?:(ERROR|WARNING|INFO): ?)?(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"endColumn": 4,
					"severity": 5,
					"message": 6
				}
			}
		],
		"keybindings": [
			{
				"command": "kernelWorkbench.build",
				"key": "f7",
				"when": "kernelWorkbench.active"
			},
			{
				"command": "kernelWorkbench.compileFile",
				"key": "ctrl+f7",
				"when": "kernelWorkbench.active && editorLangId == c"
			},
			{
				"command": "kernelWorkbench.run",
				"key": "ctrl+f5",
				"when": "kernelWorkbench.active && !inDebugMode"
			},
			{
				"command": "kernelWorkbench.debug",
				"key": "f5",
				"when": "kernelWorkbench.active && !inDebugMode"
			}
		],
		"configuration": [
			{
				"title": "Configure",
				"order": 1,
				"properties": {
					"kernelWorkbench.arch": {
						"type": "string",
						"enum": [
							"",
							"x86_64",
							"arm64",
							"riscv64"
						],
						"default": "",
						"description": "Default architecture for trees where none was picked. Empty: the host architecture.",
						"scope": "resource"
					},
					"kernelWorkbench.variant": {
						"type": "string",
						"enum": [
							"debug",
							"release"
						],
						"default": "debug",
						"description": "Default build variant for trees where none was picked.",
						"scope": "resource"
					},
					"kernelWorkbench.configure.defconfig": {
						"type": "string",
						"default": "defconfig",
						"markdownDescription": "Default base config: one or more make targets (`defconfig`, `defconfig kvm_guest.config`, `tinyconfig`) or a path to a `.config` file. A base config picked for an architecture overrides it.",
						"scope": "resource"
					},
					"kernelWorkbench.configure.fragments": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"markdownDescription": "Config fragments merged after the base config (`scripts/kconfig/merge_config.sh`). Paths relative to the kernel tree, e.g. `kernel/configs/debug.config`.",
						"scope": "resource"
					},
					"kernelWorkbench.configure.options": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {},
						"markdownDescription": "Kconfig options applied last, without the `CONFIG_` prefix: `\"y\"`, `\"n\"`, `\"m\"`, a number or a string. Example: `{ \"KASAN\": \"y\", \"LOG_BUF_SHIFT\": \"18\" }`.",
						"scope": "resource"
					},
					"kernelWorkbench.configure.debugOptions": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {
							"DEBUG_KERNEL": "y",
							"DEBUG_INFO_NONE": "n",
							"DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT": "y",
							"DEBUG_INFO_REDUCED": "n",
							"DEBUG_INFO_SPLIT": "n",
							"GDB_SCRIPTS": "y"
						},
						"markdownDescription": "Kconfig options for the **Debug** variant.",
						"scope": "resource"
					},
					"kernelWorkbench.configure.releaseOptions": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {
							"DEBUG_INFO_NONE": "y",
							"DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT": "n",
							"DEBUG_INFO_DWARF4": "n",
							"DEBUG_INFO_DWARF5": "n"
						},
						"markdownDescription": "Kconfig options for the **Release** variant.",
						"scope": "resource"
					},
					"kernelWorkbench.configure.qemuOptions": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {
							"BLK_DEV_INITRD": "y",
							"DEVTMPFS": "y",
							"DEVTMPFS_MOUNT": "y",
							"TMPFS": "y",
							"BINFMT_ELF": "y",
							"BINFMT_SCRIPT": "y"
						},
						"markdownDescription": "Kconfig options applied at Configure when `kernelWorkbench.run.mode` is `qemu`, so the kernel can boot from an initramfs given in `kernelWorkbench.run.initramfs`.",
						"scope": "resource"
					},
					"kernelWorkbench.configure.virtmeOptions": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {
							"BLK_DEV_INITRD": "y",
							"DEVTMPFS": "y",
							"TMPFS": "y",
							"BINFMT_SCRIPT": "y",
							"VIRTIO": "y",
							"VIRTIO_PCI": "y",
							"VIRTIO_MMIO": "y",
							"VIRTIO_CONSOLE": "y",
							"VIRTIO_BLK": "y",
							"VIRTIO_NET": "y",
							"SCSI_VIRTIO": "y",
							"NET_9P": "y",
							"NET_9P_VIRTIO": "y",
							"9P_FS": "y",
							"9P_FS_POSIX_ACL": "y",
							"FUSE_FS": "y",
							"VIRTIO_FS": "y",
							"OVERLAY_FS": "y",
							"UNIX": "y",
							"INET": "y"
						},
						"markdownDescription": "Kconfig options needed by virtme-ng (applied at Configure when `kernelWorkbench.run.mode` is `virtme`).",
						"scope": "resource"
					}
				}
			},
			{
				"title": "Build",
				"order": 2,
				"properties": {
					"kernelWorkbench.toolchain": {
						"type": "string",
						"enum": [
							"gcc",
							"llvm"
						],
						"default": "gcc",
						"markdownDescription": "`gcc`: `CROSS_COMPILE=<prefix>` when cross compiling. `llvm`: `LLVM=1` for every arch. Takes effect at the next Configure.",
						"scope": "resource"
					},
					"kernelWorkbench.crossCompile": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {},
						"markdownDescription": "`CROSS_COMPILE` prefix per arch for gcc builds. Defaults: `aarch64-linux-gnu-`, `riscv64-linux-gnu-`, `x86_64-linux-gnu-` (none for the host arch).",
						"scope": "resource"
					},
					"kernelWorkbench.make.ccache": {
						"type": "boolean",
						"default": false,
						"markdownDescription": "Compile through ccache: Configure records `CC=\"ccache gcc\"` (with the cross prefix) or `CC=\"ccache clang\"`. Rebuilds after switching branches or Debug/Release get much faster. Takes effect at the next Configure.",
						"scope": "resource"
					},
					"kernelWorkbench.make.args": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"markdownDescription": "Extra make arguments, recorded at Configure and used by every Build, e.g. `[\"W=1\"]`, `[\"CC=ccache gcc\"]`, `[\"KCFLAGS=-Og\"]`.",
						"scope": "resource"
					},
					"kernelWorkbench.make.jobs": {
						"type": "integer",
						"minimum": 0,
						"default": 0,
						"description": "make -j; 0 = number of CPUs.",
						"scope": "resource"
					},
					"kernelWorkbench.buildDirectory": {
						"type": "string",
						"default": "build/${arch}/${variant}",
						"markdownDescription": "Build output (`O=`), relative to the kernel tree or absolute. `${arch}` and `${variant}` are substituted.",
						"scope": "resource"
					},
					"kernelWorkbench.clangd.updateCompileCommands": {
						"type": "boolean",
						"default": true,
						"markdownDescription": "After each build, write the build's `compile_commands.json` to the root of the tree for clangd (gcc-only flags stripped) and restart clangd.",
						"scope": "resource"
					},
					"kernelWorkbench.terminal.afterTask": {
						"type": "string",
						"enum": [
							"closeOnSuccess",
							"keep"
						],
						"default": "closeOnSuccess",
						"enumDescriptions": [
							"Close the terminal when the step succeeds; keep it open when it fails, to read the errors",
							"Keep the terminal open after every step"
						],
						"description": "What happens to the terminal of a step (Configure, Build, Clean, checks, ...) when it finishes. A failed step's terminal always stays open.",
						"scope": "resource"
					}
				}
			},
			{
				"title": "Run",
				"order": 3,
				"properties": {
					"kernelWorkbench.run.mode": {
						"type": "string",
						"enum": [
							"qemu",
							"virtme"
						],
						"default": "qemu",
						"markdownEnumDescriptions": [
							"QEMU, with the initramfs from `kernelWorkbench.run.initramfs` if one is set",
							"virtme-ng (`vng`), booting the host root filesystem"
						],
						"description": "How Run and Debug boot the kernel.",
						"scope": "resource"
					},
					"kernelWorkbench.run.initramfs": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"default": {},
						"markdownDescription": "Initramfs to boot with, per arch, e.g. `{ \"arm64\": \"/srv/initramfs/arm64.cpio.gz\" }`. If none is set for the arch, the kernel boots without an initramfs (give `root=` in `kernelWorkbench.run.cmdline` and a disk in `kernelWorkbench.run.qemuArgs`).",
						"scope": "resource"
					},
					"kernelWorkbench.run.memory": {
						"type": "string",
						"default": "2G",
						"description": "Guest memory (QEMU -m).",
						"scope": "resource"
					},
					"kernelWorkbench.run.smp": {
						"type": "integer",
						"minimum": 1,
						"default": 2,
						"description": "Guest CPUs (QEMU -smp).",
						"scope": "resource"
					},
					"kernelWorkbench.run.kvm": {
						"type": "string",
						"enum": [
							"auto",
							"on",
							"off"
						],
						"default": "auto",
						"description": "auto: use KVM when the arch is native and /dev/kvm is accessible.",
						"scope": "resource"
					},
					"kernelWorkbench.run.cmdline": {
						"type": "string",
						"default": "",
						"description": "Extra kernel command line.",
						"scope": "resource"
					},
					"kernelWorkbench.run.qemuArgs": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"markdownDescription": "Extra QEMU arguments, e.g. `[\"-device\", \"virtio-rng-pci\"]`.",
						"scope": "resource"
					},
					"kernelWorkbench.run.virtmeArgs": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"description": "Extra vng arguments (virtme mode).",
						"scope": "resource"
					},
					"kernelWorkbench.run.shareBuildDir": {
						"type": "boolean",
						"default": false,
						"markdownDescription": "Share the build directory with the QEMU guest over 9p (read-only), so freshly built modules can be loaded with `insmod` without rebuilding the initramfs. Configure then enables the 9p and virtio options; Run shows the `mount` command for the guest.",
						"scope": "resource"
					},
					"kernelWorkbench.buildBeforeRun": {
						"type": "boolean",
						"default": true,
						"description": "Run an incremental build before Run and Debug.",
						"scope": "resource"
					}
				}
			},
			{
				"title": "Debug",
				"order": 4,
				"properties": {
					"kernelWorkbench.debug.debugger": {
						"type": "string",
						"enum": [
							"auto",
							"cppdbg",
							"gdb",
							"lldb"
						],
						"default": "auto",
						"markdownEnumDescriptions": [
							"First installed of the below",
							"ms-vscode.cpptools (VS Code)",
							"webfreak.debug, Native Debug (VSCodium)",
							"CodeLLDB (no lx-* gdb helpers)"
						],
						"description": "Debugger front end.",
						"scope": "resource"
					},
					"kernelWorkbench.debug.gdb": {
						"type": "string",
						"default": "",
						"description": "gdb binary. Empty: gdb for the host arch, gdb-multiarch otherwise.",
						"scope": "resource"
					},
					"kernelWorkbench.debug.port": {
						"type": "integer",
						"default": 1234,
						"description": "QEMU gdbstub TCP port.",
						"scope": "resource"
					},
					"kernelWorkbench.debug.breakAt": {
						"type": "string",
						"default": "start_kernel",
						"description": "Run to this symbol (hardware breakpoint) before the debugger attaches, so normal breakpoints work. Empty: attach at reset.",
						"scope": "resource"
					},
					"kernelWorkbench.debug.stopOnEntry": {
						"type": "boolean",
						"default": false,
						"description": "Stay paused at breakAt when the debugger attaches, instead of running to your breakpoints.",
						"scope": "resource"
					},
					"kernelWorkbench.debug.gdbCommands": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"description": "Extra gdb commands run when the debugger starts.",
						"scope": "resource"
					},
					"kernelWorkbench.debug.stopVmWhenDebuggingEnds": {
						"type": "boolean",
						"default": true,
						"description": "Kill QEMU when the debug session ends.",
						"scope": "resource"
					}
				}
			},
			{
				"title": "KUnit",
				"order": 5,
				"properties": {
					"kernelWorkbench.kunit.buildDirectory": {
						"type": "string",
						"default": "build/kunit/${arch}",
						"markdownDescription": "Build directory for `kunit.py`, kept apart from the builds, relative to the kernel tree or absolute. `${arch}` is substituted.",
						"scope": "resource"
					},
					"kernelWorkbench.kunit.kunitconfig": {
						"type": "string",
						"default": "",
						"markdownDescription": "`.kunitconfig` (a file or a directory) for the Testing view's runs, e.g. `lib/kunit` or `kernel/sched`. Empty: kunit.py's default set.",
						"scope": "resource"
					}
				}
			},
			{
				"title": "Git",
				"order": 6,
				"properties": {
					"kernelWorkbench.blame.ignoreWhitespace": {
						"type": "boolean",
						"default": true,
						"markdownDescription": "Blame with `-w`: whitespace-only changes do not count as changing a line.",
						"scope": "resource"
					},
					"kernelWorkbench.blame.detectMoves": {
						"type": "boolean",
						"default": false,
						"markdownDescription": "Blame with `-M -C`: follow lines moved within the file or copied from other files changed in the same commit. Slower.",
						"scope": "resource"
					},
					"kernelWorkbench.patches.base": {
						"type": "string",
						"default": "origin/master",
						"markdownDescription": "Base of a patch series when the branch has no upstream and none was picked in the Series view: the series is the commits since its merge-base with this ref.",
						"scope": "resource"
					},
					"kernelWorkbench.checkpatch.strict": {
						"type": "boolean",
						"default": false,
						"markdownDescription": "Run checkpatch with `--strict` (some subsystems, e.g. networking, expect it).",
						"scope": "resource"
					},
					"kernelWorkbench.checkpatch.ignore": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"markdownDescription": "checkpatch types to ignore (`--ignore`), e.g. `[\"FILE_PATH_CHANGES\"]`.",
						"scope": "resource"
					},
					"kernelWorkbench.check.sparse": {
						"type": "boolean",
						"default": false,
						"markdownDescription": "Also run sparse (`C=2`) on the touched files in Check Series. Needs a sparse recent enough for the kernel.",
						"scope": "resource"
					},
					"kernelWorkbench.check.coccinelle": {
						"type": "boolean",
						"default": false,
						"markdownDescription": "Also run `make coccicheck MODE=report` on the touched directories in Check Series. Needs `coccinelle` and `ocaml-nox`.",
						"scope": "resource"
					},
					"kernelWorkbench.patches.outputDirectory": {
						"type": "string",
						"default": "patches/${branch}/v${version}",
						"markdownDescription": "Where Generate Patches writes the series, relative to the kernel tree or absolute. `${branch}` and `${version}` are substituted.",
						"scope": "resource"
					}
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vscode-test",
		"package": "vsce package",
		"test:unit": "npm run compile && mocha",
		"test:integration": "npm run compile && mocha --no-config out/test/integration/*.integration.js && node out/test/integration/run.js",
		"test:ui": "npm run compile && node out/test/ui/run.js"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/vscode": "^1.140.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^4.0.0",
		"eslint": "^10.5.0",
		"jsonc-parser": "^3.3.1",
		"mocha": "^11.8.0",
		"prettier": "3.9.9",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1",
		"vscode-extension-tester": "^8.28.1"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	}
}
