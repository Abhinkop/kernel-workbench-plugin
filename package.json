{
	"name": "kernel-dev",
	"displayName": "Kernel Dev: Configure, Build, Run, Debug",
	"description": "Visual Studio-style Configure / Build / Run / Debug for the Linux kernel: a Kernel panel and editor toolbar with arch, Debug/Release and config; QEMU + gdb; clangd set up automatically. No per-workspace files.",
	"version": "0.4.0",
	"publisher": "ajose",
	"license": "GPL-2.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/Abhinkop/kernel-workbench-plugin.git"
	},
	"bugs": {
		"url": "https://github.com/Abhinkop/kernel-workbench-plugin/issues"
	},
	"homepage": "https://github.com/Abhinkop/kernel-workbench-plugin#readme",
	"engines": {
		"vscode": "^1.140.0"
	},
	"categories": [
		"Programming Languages",
		"Debuggers",
		"Other"
	],
	"keywords": [
		"linux",
		"kernel",
		"kbuild",
		"qemu",
		"gdb",
		"clangd"
	],
	"main": "./out/extension.js",
	"extensionKind": [
		"workspace"
	],
	"activationEvents": [
		"workspaceContains:Kbuild"
	],
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vscode-test",
		"package": "vsce package",
		"test:unit": "npm run compile && node --test out/test/unit/kernelTree.unit.js",
		"test:integration": "npm run compile && node --test out/test/integration/kernelTree.integration.js && vscode-test --label mainline-kernel"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/vscode": "^1.140.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^4.0.0",
		"eslint": "^10.5.0",
		"prettier": "3.9.9",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	}
}
