{
	"name": "kernel-workbench",
	"displayName": "Kernel Workbench: Configure, Build, Run, Debug",
	"description": "Visual Studio-style Configure / Build / Run / Debug for the Linux kernel: a Kernel panel and editor toolbar with arch, Debug/Release and config; QEMU + gdb; clangd set up automatically. No per-workspace files.",
	"version": "0.4.0",
	"publisher": "ajose",
	"license": "GPL-2.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/Abhinkop/kernel-workbench-plugin.git"
	},
	"bugs": {
		"url": "https://github.com/Abhinkop/kernel-workbench-plugin/issues"
	},
	"homepage": "https://github.com/Abhinkop/kernel-workbench-plugin#readme",
	"engines": {
		"vscode": "^1.140.0"
	},
	"categories": [
		"Programming Languages",
		"Debuggers",
		"Other"
	],
	"keywords": [
		"linux",
		"kernel",
		"kbuild",
		"qemu",
		"gdb",
		"clangd",
		"kunit",
		"git",
		"checkpatch"
	],
	"main": "./out/extension.js",
	"extensionKind": [
		"workspace"
	],
	"activationEvents": [
		"workspaceContains:Kbuild"
	],
	"contributes": {
		"commands": [
			{
				"command": "kernelWorkbench.selectArch",
				"title": "Select Architecture…",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.selectVariant",
				"title": "Select Debug or Release…",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.selectConfig",
				"title": "Select Base Config…",
				"category": "Kernel",
				"icon": "$(file-code)"
			},
			{
				"command": "kernelWorkbench.editItem",
				"title": "Change…",
				"category": "Kernel",
				"icon": "$(edit)"
			},
			{
				"command": "kernelWorkbench.configure",
				"title": "Configure",
				"category": "Kernel",
				"icon": "$(gear)"
			},
			{
				"command": "kernelWorkbench.build",
				"title": "Build",
				"category": "Kernel",
				"icon": "$(tools)"
			},
			{
				"command": "kernelWorkbench.rebuild",
				"title": "Rebuild (Clean + Build)",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.clean",
				"title": "Clean",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.mrproper",
				"title": "Full Clean (mrproper)",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.menuconfig",
				"title": "Run menuconfig",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.nconfig",
				"title": "Run nconfig",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.checkTools",
				"title": "Check Required Tools",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.installTools",
				"title": "Install Missing Tools",
				"category": "Kernel",
				"icon": "$(cloud-download)"
			},
			{
				"command": "kernelWorkbench.followSelection",
				"title": "Point clangd at the Selected Build",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.compileFile",
				"title": "Compile Current File",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.preprocessFile",
				"title": "Preprocess Current File (.i)",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.assembleFile",
				"title": "Show Assembly for Current File (.s)",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.buildModules",
				"title": "Build Modules",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.buildDirectory",
				"title": "Build This Directory",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.run",
				"title": "Run in QEMU",
				"category": "Kernel",
				"icon": "$(play)"
			},
			{
				"command": "kernelWorkbench.stop",
				"title": "Stop VM",
				"category": "Kernel",
				"icon": "$(debug-stop)"
			},
			{
				"command": "kernelWorkbench.debug",
				"title": "Debug in QEMU",
				"category": "Kernel",
				"icon": "$(debug-alt)"
			},
			{
				"command": "kernelWorkbench.oops.decode",
				"title": "Decode Stack Trace",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.kunit.runDirectory",
				"title": "Run KUnit Tests for This Directory",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.git.openCommit",
				"title": "Open Commit",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.git.commitWhole",
				"title": "Show Whole Commit",
				"category": "Kernel",
				"icon": "$(files)"
			},
			{
				"command": "kernelWorkbench.git.commitFileOnly",
				"title": "Show Only This File",
				"category": "Kernel",
				"icon": "$(file)"
			},
			{
				"command": "kernelWorkbench.history.showFile",
				"title": "Show File History",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.history.showLines",
				"title": "Show History of Selected Lines",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.history.loadMore",
				"title": "Load More History",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.history.refresh",
				"title": "Refresh File History",
				"category": "Kernel",
				"icon": "$(refresh)"
			},
			{
				"command": "kernelWorkbench.history.filter",
				"title": "Filter History by Message or Author…",
				"category": "Kernel",
				"icon": "$(filter)"
			},
			{
				"command": "kernelWorkbench.history.clearFilter",
				"title": "Clear History Filter",
				"category": "Kernel",
				"icon": "$(clear-all)"
			},
			{
				"command": "kernelWorkbench.git.copyHash",
				"title": "Copy Commit Hash",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.git.copyFixes",
				"title": "Copy Fixes: Line",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.git.openAtCommit",
				"title": "Open File at This Commit",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.git.compareWithPrevious",
				"title": "Compare with Previous Version",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.git.openOnLore",
				"title": "Open on lore.kernel.org",
				"category": "Kernel",
				"icon": "$(link-external)"
			},
			{
				"command": "kernelWorkbench.blame.toggle",
				"title": "Toggle Blame Annotations",
				"category": "Kernel",
				"icon": "$(person)"
			},
			{
				"command": "kernelWorkbench.blame.before",
				"title": "Blame Before This Commit",
				"category": "Kernel",
				"icon": "$(history)"
			},
			{
				"command": "kernelWorkbench.blame.copyFixes",
				"title": "Copy Fixes: Line",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.blame.copyHash",
				"title": "Copy Commit Hash",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.blame.openOnLore",
				"title": "Open on lore.kernel.org",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.series.refresh",
				"title": "Refresh Series",
				"category": "Kernel",
				"icon": "$(refresh)"
			},
			{
				"command": "kernelWorkbench.series.check",
				"title": "Check Series",
				"category": "Kernel",
				"icon": "$(checklist)"
			},
			{
				"command": "kernelWorkbench.series.checkWorking",
				"title": "Check Working Changes",
				"category": "Kernel",
				"icon": "$(checklist)"
			},
			{
				"command": "kernelWorkbench.series.format",
				"title": "Format Changed Lines",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.series.pickBase",
				"title": "Pick Series Base…",
				"category": "Kernel",
				"icon": "$(edit)"
			},
			{
				"command": "kernelWorkbench.series.nextVersion",
				"title": "Next Series Version",
				"category": "Kernel",
				"icon": "$(add)"
			},
			{
				"command": "kernelWorkbench.series.previousVersion",
				"title": "Previous Series Version",
				"category": "Kernel",
				"icon": "$(remove)"
			},
			{
				"command": "kernelWorkbench.series.report",
				"title": "Show checkpatch Report",
				"category": "Kernel",
				"icon": "$(output)"
			},
			{
				"command": "kernelWorkbench.series.editCover",
				"title": "Edit Cover Letter",
				"category": "Kernel",
				"icon": "$(edit)"
			},
			{
				"command": "kernelWorkbench.series.editPrefix",
				"title": "Edit Subject Prefix…",
				"category": "Kernel",
				"icon": "$(edit)"
			},
			{
				"command": "kernelWorkbench.series.editRecipients",
				"title": "Edit Recipients",
				"category": "Kernel",
				"icon": "$(edit)"
			},
			{
				"command": "kernelWorkbench.series.fillRecipients",
				"title": "Fill Recipients from get_maintainer.pl",
				"category": "Kernel",
				"icon": "$(person-add)"
			},
			{
				"command": "kernelWorkbench.series.generate",
				"title": "Generate Patches",
				"category": "Kernel",
				"icon": "$(package)"
			},
			{
				"command": "kernelWorkbench.series.revealOutput",
				"title": "Reveal Patches Folder",
				"category": "Kernel",
				"icon": "$(folder-opened)"
			},
			{
				"command": "kernelWorkbench.series.dryRun",
				"title": "Send Patches: Dry Run",
				"category": "Kernel"
			},
			{
				"command": "kernelWorkbench.series.send",
				"title": "Send Patches…",
				"category": "Kernel",
				"icon": "$(send)"
			}
		],
		"submenus": [
			{
				"id": "kernelWorkbench.target",
				"label": "Kernel Workbench",
				"icon": "$(chip)"
			},
			{
				"id": "kernelWorkbench.editorContext",
				"label": "Kernel Workbench"
			},
			{
				"id": "kernelWorkbench.explorerContext",
				"label": "Kernel Workbench"
			}
		],
		"menus": {
			"editor/context": [
				{
					"submenu": "kernelWorkbench.editorContext",
					"when": "kernelWorkbench.active && (resourceScheme == file || resourceScheme == kernel-git)",
					"group": "z_kernel@1"
				}
			],
			"explorer/context": [
				{
					"submenu": "kernelWorkbench.explorerContext",
					"when": "kernelWorkbench.active",
					"group": "z_kernel@1"
				}
			],
			"kernelWorkbench.editorContext": [
				{
					"command": "kernelWorkbench.compileFile",
					"when": "kernelWorkbench.active && resourceExtname =~ /^\\.[cS]$/",
					"group": "1_build@1"
				},
				{
					"command": "kernelWorkbench.preprocessFile",
					"when": "kernelWorkbench.active && resourceExtname == .c",
					"group": "1_build@2"
				},
				{
					"command": "kernelWorkbench.assembleFile",
					"when": "kernelWorkbench.active && resourceExtname == .c",
					"group": "1_build@3"
				},
				{
					"command": "kernelWorkbench.buildDirectory",
					"when": "kernelWorkbench.active && resourceScheme == file",
					"group": "1_build@4"
				},
				{
					"command": "kernelWorkbench.oops.decode",
					"when": "kernelWorkbench.active && editorHasSelection",
					"group": "3_debug@1"
				},
				{
					"command": "kernelWorkbench.history.showFile",
					"when": "kernelWorkbench.active && resourceScheme == file",
					"group": "2_git@1"
				},
				{
					"command": "kernelWorkbench.history.showLines",
					"when": "kernelWorkbench.active && resourceScheme == file && editorHasSelection",
					"group": "2_git@2"
				},
				{
					"command": "kernelWorkbench.blame.toggle",
					"when": "kernelWorkbench.active && (resourceScheme == file || resourceScheme == kernel-git && resourcePath =~ /^\\/blob\\//)",
					"group": "2_git@3"
				}
			],
			"kernelWorkbench.explorerContext": [
				{
					"command": "kernelWorkbench.buildDirectory",
					"when": "kernelWorkbench.active",
					"group": "2_build@1"
				},
				{
					"command": "kernelWorkbench.kunit.runDirectory",
					"when": "kernelWorkbench.active",
					"group": "2_build@2"
				},
				{
					"command": "kernelWorkbench.history.showFile",
					"when": "kernelWorkbench.active && !explorerResourceIsFolder",
					"group": "1_git@1"
				}
			],
			"editor/title": [
				{
					"submenu": "kernelWorkbench.target",
					"when": "kernelWorkbench.active && resourceScheme != kernel-git",
					"group": "navigation@-10"
				},
				{
					"command": "kernelWorkbench.configure",
					"when": "kernelWorkbench.active && resourceScheme != kernel-git",
					"group": "navigation@-9"
				},
				{
					"command": "kernelWorkbench.build",
					"when": "kernelWorkbench.active && resourceScheme != kernel-git",
					"group": "navigation@-8"
				},
				{
					"command": "kernelWorkbench.run",
					"when": "kernelWorkbench.active && resourceScheme != kernel-git && !kernelWorkbench.vmRunning",
					"group": "navigation@-7"
				},
				{
					"command": "kernelWorkbench.debug",
					"when": "kernelWorkbench.active && resourceScheme != kernel-git && !kernelWorkbench.vmRunning",
					"group": "navigation@-6"
				},
				{
					"command": "kernelWorkbench.stop",
					"when": "kernelWorkbench.active && resourceScheme != kernel-git && kernelWorkbench.vmRunning",
					"group": "navigation@-5"
				},
				{
					"command": "kernelWorkbench.git.commitWhole",
					"when": "resourceScheme == kernel-git && resourcePath =~ /^\\/file\\//",
					"group": "navigation@1"
				},
				{
					"command": "kernelWorkbench.git.commitFileOnly",
					"when": "resourceScheme == kernel-git && resourcePath =~ /^\\/full\\//",
					"group": "navigation@1"
				},
				{
					"command": "kernelWorkbench.git.copyFixes",
					"when": "resourceScheme == kernel-git && resourcePath =~ /^\\/(commit|full|file|stat)\\//",
					"group": "1_kernel@1"
				},
				{
					"command": "kernelWorkbench.git.copyHash",
					"when": "resourceScheme == kernel-git && resourcePath =~ /^\\/(commit|full|file|stat)\\//",
					"group": "1_kernel@2"
				},
				{
					"command": "kernelWorkbench.git.openOnLore",
					"when": "resourceScheme == kernel-git && resourcePath =~ /^\\/(commit|full|file|stat)\\//",
					"group": "1_kernel@3"
				},
				{
					"command": "kernelWorkbench.blame.toggle",
					"when": "kernelWorkbench.active && (resourceScheme == file || resourceScheme == kernel-git && resourcePath =~ /^\\/blob\\//)",
					"group": "1_kernel@0"
				}
			],
			"view/title": [
				{
					"command": "kernelWorkbench.configure",
					"when": "view == kernelWorkbench.kernel",
					"group": "navigation@1"
				},
				{
					"command": "kernelWorkbench.build",
					"when": "view == kernelWorkbench.kernel",
					"group": "navigation@2"
				},
				{
					"command": "kernelWorkbench.run",
					"when": "view == kernelWorkbench.kernel && !kernelWorkbench.vmRunning",
					"group": "navigation@3"
				},
				{
					"command": "kernelWorkbench.debug",
					"when": "view == kernelWorkbench.kernel && !kernelWorkbench.vmRunning",
					"group": "navigation@4"
				},
				{
					"command": "kernelWorkbench.stop",
					"when": "view == kernelWorkbench.kernel && kernelWorkbench.vmRunning",
					"group": "navigation@5"
				},
				{
					"command": "kernelWorkbench.menuconfig",
					"when": "view == kernelWorkbench.kernel",
					"group": "1_config@1"
				},
				{
					"command": "kernelWorkbench.nconfig",
					"when": "view == kernelWorkbench.kernel",
					"group": "1_config@2"
				},
				{
					"command": "kernelWorkbench.clean",
					"when": "view == kernelWorkbench.kernel",
					"group": "2_clean@1"
				},
				{
					"command": "kernelWorkbench.rebuild",
					"when": "view == kernelWorkbench.kernel",
					"group": "2_clean@2"
				},
				{
					"command": "kernelWorkbench.mrproper",
					"when": "view == kernelWorkbench.kernel",
					"group": "2_clean@3"
				},
				{
					"command": "kernelWorkbench.buildModules",
					"when": "view == kernelWorkbench.kernel",
					"group": "3_tools@1"
				},
				{
					"command": "kernelWorkbench.checkTools",
					"when": "view == kernelWorkbench.kernel",
					"group": "3_tools@3"
				},
				{
					"command": "kernelWorkbench.history.filter",
					"when": "view == kernelWorkbench.history",
					"group": "navigation@1"
				},
				{
					"command": "kernelWorkbench.history.clearFilter",
					"when": "view == kernelWorkbench.history",
					"group": "navigation@2"
				},
				{
					"command": "kernelWorkbench.history.refresh",
					"when": "view == kernelWorkbench.history",
					"group": "navigation@3"
				},
				{
					"command": "kernelWorkbench.blame.toggle",
					"when": "view == kernelWorkbench.blame",
					"group": "navigation@1"
				},
				{
					"command": "kernelWorkbench.series.check",
					"when": "view == kernelWorkbench.series && !kernelWorkbench.seriesBusy",
					"group": "navigation@1"
				},
				{
					"command": "kernelWorkbench.series.refresh",
					"when": "view == kernelWorkbench.series",
					"group": "navigation@9"
				},
				{
					"command": "kernelWorkbench.series.checkWorking",
					"when": "view == kernelWorkbench.series",
					"group": "1_check@1"
				},
				{
					"command": "kernelWorkbench.series.format",
					"when": "view == kernelWorkbench.series",
					"group": "1_check@2"
				},
				{
					"command": "kernelWorkbench.series.nextVersion",
					"when": "view == kernelWorkbench.series",
					"group": "2_series@5"
				},
				{
					"command": "kernelWorkbench.series.pickBase",
					"when": "view == kernelWorkbench.series",
					"group": "2_series@6"
				},
				{
					"command": "kernelWorkbench.series.generate",
					"when": "view == kernelWorkbench.series && !kernelWorkbench.seriesNoBase",
					"group": "navigation@2"
				},
				{
					"command": "kernelWorkbench.series.fillRecipients",
					"when": "view == kernelWorkbench.series",
					"group": "2_series@1"
				},
				{
					"command": "kernelWorkbench.series.editRecipients",
					"when": "view == kernelWorkbench.series",
					"group": "2_series@2"
				},
				{
					"command": "kernelWorkbench.series.editCover",
					"when": "view == kernelWorkbench.series",
					"group": "2_series@3"
				},
				{
					"command": "kernelWorkbench.series.editPrefix",
					"when": "view == kernelWorkbench.series",
					"group": "2_series@4"
				},
				{
					"command": "kernelWorkbench.series.send",
					"when": "view == kernelWorkbench.series && kernelWorkbench.dryRunOk",
					"group": "navigation@3"
				},
				{
					"command": "kernelWorkbench.series.dryRun",
					"when": "view == kernelWorkbench.series && kernelWorkbench.patchesGenerated",
					"group": "3_send@1"
				},
				{
					"command": "kernelWorkbench.series.send",
					"when": "view == kernelWorkbench.series && kernelWorkbench.patchesGenerated",
					"group": "3_send@2"
				}
			],
			"kernelWorkbench.target": [
				{
					"command": "kernelWorkbench.configure",
					"group": "0_steps@1"
				},
				{
					"command": "kernelWorkbench.build",
					"group": "0_steps@2"
				},
				{
					"command": "kernelWorkbench.run",
					"group": "0_steps@3",
					"when": "!kernelWorkbench.vmRunning"
				},
				{
					"command": "kernelWorkbench.debug",
					"group": "0_steps@4",
					"when": "!kernelWorkbench.vmRunning"
				},
				{
					"command": "kernelWorkbench.stop",
					"group": "0_steps@5",
					"when": "kernelWorkbench.vmRunning"
				},
				{
					"command": "kernelWorkbench.selectArch",
					"group": "1_target@1"
				},
				{
					"command": "kernelWorkbench.selectVariant",
					"group": "1_target@2"
				},
				{
					"command": "kernelWorkbench.selectConfig",
					"group": "1_target@3"
				},
				{
					"command": "kernelWorkbench.menuconfig",
					"group": "3_config@2"
				},
				{
					"command": "kernelWorkbench.clean",
					"group": "4_tools@1"
				},
				{
					"command": "kernelWorkbench.rebuild",
					"group": "4_tools@2"
				},
				{
					"command": "kernelWorkbench.mrproper",
					"group": "4_tools@3"
				},
				{
					"command": "kernelWorkbench.buildModules",
					"group": "4_tools@4"
				}
			],
			"commandPalette": [
				{
					"command": "kernelWorkbench.selectArch",
					"when": "kernelWorkbench.active"
				},
				{
					"command": "kernelWorkbench.selectVariant",
					"when": "kernelWorkbench.active"
				},
				{
					"command": "kernelWorkbench.selectConfig",
					"when": "kernelWorkbench.active"
				},
				{
					"command": "kernelWorkbench.editItem",
					"when": "false"
				},
				{
					"command": "kernelWorkbench.configure",
					"when": "kernelWorkbench.active"
				},
				{
					"command": "kernelWorkbench.build",
					"when": "kernelWorkbench.active"
				},
				{
					"command": "kernelWorkbench.rebuild",
					"when": "kernelWorkbench.active"
				},
				{
					"command": "kernelWorkbench.clean",
					"when": "kernelWorkbench.active"
				},
