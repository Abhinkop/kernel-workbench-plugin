// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "npm",
			"script": "lint",
			"problemMatcher": "$eslint-stylish",
			"label": "npm: lint"
		},
		{
			// Runs against the kernel tree in kernelWorkbench.dev.kernelTree, the same one
			// "Run Extension" opens.
			"type": "npm",
			"script": "test:integration",
			"label": "npm: test:integration",
			"group": "test",
			"options": {
				"env": {
					"KERNEL_TREE": "${config:kernelWorkbench.dev.kernelTree}"
				}
			}
		},
		{
			// Sets kernelWorkbench.dev.kernelTree, the kernel tree used for developing this extension
			"label": "Configure kernel tree",
			"type": "process",
			"command": "node",
			"args": ["${workspaceFolder}/scripts/configure-kernel-tree.mjs", "${input:kernelTree}"],
			"problemMatcher": []
		},
		{
			// The integration tests plus the end-to-end ones, which build a kernel (minutes)
			"type": "npm",
			"script": "test:integration",
			"label": "npm: test:integration (end to end)",
			"group": "test",
			"options": {
				"env": {
					"KERNEL_TREE": "${config:kernelWorkbench.dev.kernelTree}",
					"KERNEL_E2E": "1"
				}
			}
		},
		{
			// Clicks through a real VS Code window on the kernel tree in
			// kernelWorkbench.dev.kernelTree
			"type": "npm",
			"script": "test:ui",
			"label": "npm: test:ui",
			"group": "test",
			"options": {
				"env": {
					"KERNEL_TREE": "${config:kernelWorkbench.dev.kernelTree}"
				}
			}
		}
	],
	"inputs": [
		{
			"id": "kernelTree",
			"type": "promptString",
			"description": "Path to your Linux kernel clone"
		}
	]
}
